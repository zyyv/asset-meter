{
  "publisher": "zyyv",
  "name": "vscode-asset-size",
  "displayName": "Assets Size",
  "version": "0.3.0",
  "packageManager": "pnpm@12.14.0",
  "description": "See asset sizes and folder counts in Explorer. Compress JPEG, PNG and WebP with jSquash or TinyPNG, and compare before saving.",
  "license": "MIT",
  "galleryBanner": {
    "color": "#171C20",
    "theme": "dark"
  },
  "homepage": "https://github.com/zyyv/vscode-assets-size#readme",
  "qna": "https://github.com/zyyv/vscode-assets-size/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/vscode-assets-size.git"
  },
  "bugs": {
    "url": "https://github.com/zyyv/vscode-assets-size/issues"
  },
  "keywords": [
    "size",
    "assets",
    "explorer",
    "folder",
    "file count",
    "image compression",
    "png",
    "jpeg",
    "webp",
    "file size"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "assetSize.refresh",
        "title": "Assets Size: Refresh Sizes",
        "icon": "$(refresh)"
      },
      {
        "command": "assetSize.toggleDisplayMode",
        "title": "Assets Size: Toggle Always / Hover",
        "icon": "$(eye)"
      },
      {
        "command": "assetSize.openSettings",
        "title": "Assets Size: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "assetSize.compressImage",
        "title": "Assets Size: Compress Image",
        "icon": "$(fold)"
      },
      {
        "command": "assetSize.installNativePatch",
        "title": "Assets Size: Install / Reapply Native Explorer Patch"
      },
      {
        "command": "assetSize.restoreNativePatch",
        "title": "Assets Size: Restore Native Explorer Patch"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "assetSize.refresh",
          "group": "7_modification@90"
        },
        {
          "command": "assetSize.compressImage",
          "when": "resourceExtname =~ /\\.(jpe?g|jpe|png|webp)$/i",
          "group": "7_modification@91"
        }
      ],
      "editor/title": [
        {
          "command": "assetSize.compressImage",
          "when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname =~ /\\.(jpe?g|jpe|png|webp)$/i",
          "group": "navigation@10"
        }
      ]
    },
    "colors": [
      {
        "id": "assetSize.sizeWarning",
        "description": "Yellow size text for resources above the warning threshold.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#946800",
          "highContrast": "#FFFF00",
          "highContrastLight": "#795E00"
        }
      },
      {
        "id": "assetSize.sizeLarge",
        "description": "Orange size text for large resources.",
        "defaults": {
          "dark": "#F0883E",
          "light": "#BC4C00",
          "highContrast": "#FFAA33",
          "highContrastLight": "#A63A00"
        }
      },
      {
        "id": "assetSize.sizeCritical",
        "description": "Red size text for very large resources.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#FF6666",
          "highContrastLight": "#B00020"
        }
      }
    ],
    "configuration": {
      "title": "Assets Size",
      "properties": {
        "assetSize.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable size calculations and decorations."
        },
        "assetSize.displayMode": {
          "type": "string",
          "enum": [
            "always",
            "hover"
          ],
          "enumDescriptions": [
            "Show file counts followed by full sizes in Explorer. Requires the native Explorer patch.",
            "Show file counts and sizes on the right only while hovering an Explorer row. Requires the native Explorer patch; tooltips remain available without it."
          ],
          "default": "always",
          "scope": "resource",
          "description": "Choose when size information is shown."
        },
        "assetSize.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "default": [
            "**/*.{jpg,jpeg,png,gif,webp,avif,svg,ico,bmp,heic,mp4,webm,mov,mp3,wav,ogg,woff,woff2,ttf,otf,pdf,zip}",
            "**/{assets,public,static,images,img,media,fonts}"
          ],
          "description": "Workspace-relative picomatch patterns selecting files and folders to decorate (case-insensitive, including dotfiles). Use **/* for all resources or [] for none. Directory patterns select the directory itself; add /** to select its descendants. Does not limit folder totals."
        },
        "assetSize.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/.DS_Store"
          ],
          "description": "Workspace-relative picomatch exclusions (case-insensitive, including dotfiles). Matching resources and their descendants are excluded from decorations and totals. Supports **, *, braces and extglobs."
        },
        "assetSize.showFileCount": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show folder file counts before the size."
        },
        "assetSize.fileCountMode": {
          "type": "string",
          "enum": [
            "recursive",
            "direct"
          ],
          "default": "recursive",
          "scope": "resource",
          "description": "Count all descendant files (recursive) or immediate child files (direct). Sizes always include descendants."
        },
        "assetSize.units": {
          "type": "string",
          "enum": [
            "binary",
            "decimal"
          ],
          "enumDescriptions": [
            "Base 1024: KiB / MiB / GiB",
            "Base 1000: KB / MB / GB"
          ],
          "default": "decimal",
          "scope": "resource",
          "description": "Size display units."
        },
        "assetSize.decimalPlaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "scope": "resource",
          "description": "Number of decimal places for sizes."
        },
        "assetSize.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color only the trailing size text by severity. Filenames and file counts keep their original colors."
        },
        "assetSize.fileColorThresholdsMiB": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.25,
            1,
            5
          ],
          "scope": "resource",
          "description": "Yellow, orange and red file-size thresholds in MiB (1024 squared bytes). Values are sorted in ascending order."
        },
        "assetSize.folderColorThresholdsMiB": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            10,
            50,
            100
          ],
          "scope": "resource",
          "description": "Yellow, orange and red folder-size thresholds in MiB. Values are sorted in ascending order."
        },
        "assetSize.refreshDelay": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000,
          "default": 400,
          "description": "Delay in milliseconds for batching filesystem updates."
        },
        "assetSize.compression.plugin": {
          "type": "string",
          "default": "jsquash",
          "scope": "resource",
          "description": "Preferred compression plugin ID, shown first in the plugin picker. Built-in plugins: jsquash (local) and tinypng (cloud). Registered plugins can also be selected."
        },
        "assetSize.compression.tinypng.apiKey": {
          "type": "string",
          "default": "",
          "scope": "application",
          "ignoreSync": true,
          "description": "TinyPNG API key. Configure in User Settings; stored as plain text and excluded from Settings Sync. Selecting TinyPNG uploads images to api.tinify.com and uses your API quota."
        },
        "assetSize.compression.quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 75,
          "scope": "resource",
          "description": "jSquash JPEG and WebP compression quality. jSquash PNG is lossless. TinyPNG chooses quality automatically and ignores this setting."
        },
        "assetSize.compression.saveBehavior": {
          "type": "string",
          "enum": [
            "ask",
            "saveAs",
            "overwrite"
          ],
          "enumDescriptions": [
            "Ask for Save As or Overwrite, with Allow Once or Always Allow.",
            "Always open Save As after clicking Save Result in the comparison.",
            "Always overwrite the original after clicking Save Result in the comparison."
          ],
          "default": "ask",
          "scope": "application",
          "description": "Remembered save permission. Comparison is always shown before saving. Set to ask to reset Always Allow. Only User Settings can grant this permission."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsdown",
    "watch": "node scripts/prepare-build.mjs && tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "test:integration": "pnpm build && node scripts/run-integration.mjs",
    "test:ui": "node scripts/check-native-view.mjs",
    "test:compression:ui": "pnpm build && node scripts/check-compression-view.mjs",
    "vscode:prepublish": "pnpm typecheck && pnpm build",
    "package": "vsce package --no-dependencies --githubBranch main",
    "release": "bumpp"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "ovsx": "^1.3.0",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
