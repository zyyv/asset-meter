{
  "publisher": "zyyv",
  "name": "asset-meter",
  "displayName": "Asset Meter",
  "version": "0.0.2",
  "packageManager": "pnpm@12.14.0",
  "description": "See asset sizes and folder counts in Explorer. Compress JPEG, PNG and WebP with jSquash or TinyPNG, and compare before saving.",
  "license": "MIT",
  "galleryBanner": {
    "color": "#171C20",
    "theme": "dark"
  },
  "homepage": "https://github.com/zyyv/asset-meter#readme",
  "qna": "https://github.com/zyyv/asset-meter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/asset-meter.git"
  },
  "bugs": {
    "url": "https://github.com/zyyv/asset-meter/issues"
  },
  "keywords": [
    "asset meter",
    "size",
    "assets",
    "explorer",
    "folder",
    "file count",
    "image compression",
    "png",
    "jpeg",
    "webp",
    "file size"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "assetMeter.explorer",
          "name": "Asset Meter",
          "icon": "$(files)",
          "contextualTitle": "Asset Meter"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "assetMeter.explorer",
        "contents": "Open a folder to browse matching assets.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "assetMeter.explorer",
        "contents": "No matching files or folders. Check that Asset Meter is enabled and adjust your include / exclude rules.\n[Open Asset Meter Settings](command:assetMeter.openSettings)",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "commands": [
      {
        "command": "assetMeter.revealInExplorer",
        "title": "Asset Meter: Reveal in Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "assetMeter.refresh",
        "title": "Asset Meter: Refresh Sizes",
        "icon": "$(refresh)"
      },
      {
        "command": "assetMeter.toggleDisplayMode",
        "title": "Asset Meter: Toggle Always / Hover",
        "icon": "$(eye)"
      },
      {
        "command": "assetMeter.openSettings",
        "title": "Asset Meter: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "assetMeter.showOutput",
        "title": "Asset Meter: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "assetMeter.diagnose",
        "title": "Asset Meter: Diagnose File Matching"
      },
      {
        "command": "assetMeter.compressImage",
        "title": "Asset Meter: Compress Image",
        "icon": "$(fold)"
      },
      {
        "command": "assetMeter.installNativePatch",
        "title": "Asset Meter: Install / Reapply Native Explorer Patch"
      },
      {
        "command": "assetMeter.restoreNativePatch",
        "title": "Asset Meter: Restore Native Explorer Patch"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "assetMeter.refresh",
          "when": "view == assetMeter.explorer",
          "group": "navigation@1"
        },
        {
          "command": "assetMeter.openSettings",
          "when": "view == assetMeter.explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "assetMeter.revealInExplorer",
          "when": "view == assetMeter.explorer",
          "group": "navigation@1"
        },
        {
          "command": "assetMeter.compressImage",
          "when": "view == assetMeter.explorer && viewItem == assetMeter.image",
          "group": "assetMeter@1"
        },
        {
          "command": "assetMeter.diagnose",
          "when": "view == assetMeter.explorer",
          "group": "assetMeter@2"
        }
      ],
      "commandPalette": [
        {
          "command": "assetMeter.revealInExplorer",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "assetMeter.refresh",
          "group": "7_modification@90"
        },
        {
          "command": "assetMeter.compressImage",
          "when": "resourceExtname =~ /\\.(jpe?g|jpe|png|webp)$/i",
          "group": "7_modification@91"
        },
        {
          "command": "assetMeter.diagnose",
          "group": "7_modification@92"
        }
      ],
      "editor/title": [
        {
          "command": "assetMeter.compressImage",
          "when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname =~ /\\.(jpe?g|jpe|png|webp)$/i",
          "group": "navigation@10"
        }
      ]
    },
    "colors": [
      {
        "id": "assetMeter.sizeWarning",
        "description": "Yellow size text for resources above the warning threshold.",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#946800",
          "highContrast": "#FFFF00",
          "highContrastLight": "#795E00"
        }
      },
      {
        "id": "assetMeter.sizeLarge",
        "description": "Orange size text for large resources.",
        "defaults": {
          "dark": "#F0883E",
          "light": "#BC4C00",
          "highContrast": "#FFAA33",
          "highContrastLight": "#A63A00"
        }
      },
      {
        "id": "assetMeter.sizeCritical",
        "description": "Red size text for very large resources.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#FF6666",
          "highContrastLight": "#B00020"
        }
      }
    ],
    "configuration": {
      "title": "Asset Meter",
      "properties": {
        "assetMeter.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable size calculations and decorations."
        },
        "assetMeter.displayMode": {
          "type": "string",
          "enum": [
            "always",
            "hover"
          ],
          "enumDescriptions": [
            "Show file counts followed by full sizes with the native Explorer patch. Without it, show compact size badges or ⓘ with exact sizes in tooltips.",
            "Show file counts and sizes on the right only while hovering an Explorer row. Requires the native Explorer patch; tooltips remain available without it."
          ],
          "default": "always",
          "scope": "resource",
          "description": "Choose when size information is shown."
        },
        "assetMeter.svgOpenMode": {
          "type": "string",
          "enum": [
            "both",
            "image",
            "code"
          ],
          "enumItemLabels": [
            "Both",
            "Image",
            "Code"
          ],
          "enumDescriptions": [
            "Show editable SVG source and a live image preview side by side.",
            "Show only the SVG image preview.",
            "Show only the SVG source in the text editor."
          ],
          "default": "both",
          "scope": "resource",
          "description": "Choose how SVG files open from Explorer and the Asset Meter view."
        },
        "assetMeter.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "default": [
            "**/*.{jpg,jpeg,png,gif,webp,avif,svg,ico,bmp,heic,mp4,webm,mov,mp3,wav,ogg,woff,woff2,ttf,otf,pdf,zip}",
            "**/{assets,public,static,images,img,media,fonts}"
          ],
          "description": "Workspace-relative picomatch patterns selecting files and folders to decorate (case-insensitive, including dotfiles). Use **/* for all resources or [] for none. Directory patterns select the directory itself; add /** to select its descendants. Does not limit folder totals."
        },
        "assetMeter.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/.DS_Store"
          ],
          "description": "Workspace-relative picomatch exclusions (case-insensitive, including dotfiles). Matching resources and their descendants are excluded from decorations and totals. Supports **, *, braces and extglobs."
        },
        "assetMeter.showFileCount": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show folder file counts before the size."
        },
        "assetMeter.fileCountMode": {
          "type": "string",
          "enum": [
            "recursive",
            "direct"
          ],
          "default": "recursive",
          "scope": "resource",
          "description": "Count all descendant files (recursive) or immediate child files (direct). Sizes always include descendants."
        },
        "assetMeter.units": {
          "type": "string",
          "enum": [
            "binary",
            "decimal"
          ],
          "enumDescriptions": [
            "Base 1024: KiB / MiB / GiB",
            "Base 1000: KB / MB / GB"
          ],
          "default": "decimal",
          "scope": "resource",
          "description": "Size display units."
        },
        "assetMeter.decimalPlaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "scope": "resource",
          "description": "Number of decimal places for sizes."
        },
        "assetMeter.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color only the trailing size text by severity. Filenames and file counts keep their original colors."
        },
        "assetMeter.fileColorThresholdsMiB": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.25,
            1,
            5
          ],
          "scope": "resource",
          "description": "Yellow, orange and red file-size thresholds in MiB (1024 squared bytes). Values are sorted in ascending order."
        },
        "assetMeter.folderColorThresholdsMiB": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            10,
            50,
            100
          ],
          "scope": "resource",
          "description": "Yellow, orange and red folder-size thresholds in MiB. Values are sorted in ascending order."
        },
        "assetMeter.refreshDelay": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000,
          "default": 400,
          "description": "Delay in milliseconds for batching filesystem updates."
        },
        "assetMeter.compression.plugin": {
          "type": "string",
          "default": "jsquash",
          "scope": "resource",
          "description": "Preferred compression plugin ID, shown first in the plugin picker. Built-in plugins: jsquash (local) and tinypng (cloud). Registered plugins can also be selected."
        },
        "assetMeter.compression.tinypng.apiKey": {
          "type": "string",
          "default": "",
          "scope": "application",
          "ignoreSync": true,
          "description": "TinyPNG API key. Configure in User Settings; stored as plain text and excluded from Settings Sync. Selecting TinyPNG uploads images to api.tinify.com and uses your API quota."
        },
        "assetMeter.compression.quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 75,
          "scope": "resource",
          "description": "jSquash JPEG and WebP compression quality. jSquash PNG is lossless. TinyPNG chooses quality automatically and ignores this setting."
        },
        "assetMeter.compression.saveBehavior": {
          "type": "string",
          "enum": [
            "ask",
            "saveAs",
            "overwrite"
          ],
          "enumDescriptions": [
            "Ask for Save As or Overwrite, with Allow Once or Always Allow.",
            "Always open Save As after clicking Save Result in the comparison.",
            "Always overwrite the original after clicking Save Result in the comparison."
          ],
          "default": "ask",
          "scope": "application",
          "description": "Remembered save permission. Comparison is always shown before saving. Set to ask to reset Always Allow. Only User Settings can grant this permission."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "test:integration": "pnpm build && node scripts/run-integration.mjs",
    "test:ui": "node scripts/check-native-view.mjs",
    "test:assets:ui": "pnpm build && node scripts/check-asset-tree-view.mjs",
    "test:compression:ui": "pnpm build && node scripts/check-compression-view.mjs",
    "vscode:prepublish": "pnpm typecheck && pnpm build",
    "package": "vsce package --no-dependencies --githubBranch main",
    "release": "bumpp"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "ovsx": "^1.3.0",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
